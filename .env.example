# ============================================================
# Zayra — konfiguracja serwera (Vercel)
# Skopiuj do .env.local (lokalnie) albo wklej w Vercel → Settings → Environment Variables.
# Wystarczy JEDEN z kluczy poniżej. Klucz nie jest potrzebny, jeśli
# wpisujesz go bezpośrednio w Ustawieniach aplikacji na tablecie.
# ============================================================

# --- Opcja 1: Groq (najszybszy, darmowy) ---
# https://console.groq.com/keys
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# --- Opcja 2: Google Gemini (hojny limit darmowy) ---
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# AI_MODEL=gemini-2.5-flash

# --- Opcja 3: OpenRouter (modele z dopiskiem :free) ---
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Opcja 4: własny serwer zgodny z OpenAI (Ollama / LM Studio) ---
# OPENAI_BASE_URL=http://192.168.1.10:11434/v1
# OPENAI_API_KEY=
# AI_MODEL=llama3.1
